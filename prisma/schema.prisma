generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// HOUSEHOLD — Simple burn rate tracker (legacy)
// ──────────────────────────────────────────────

model HouseholdExpense {
  id          String            @id @default(cuid())
  date        DateTime
  amount      Decimal           @db.Decimal(12, 2)
  category    HouseholdCategory
  description String
  createdAt   DateTime          @default(now())

  @@index([date])
  @@map("household_expenses")
}

enum HouseholdCategory {
  FIXED
  VARIABLE
  FAMILY_TRAVEL
  NICOLAS
}

// ──────────────────────────────────────────────
// PERSONAL INCOME — Salary, unemployment, other (legacy)
// ──────────────────────────────────────────────

model PersonalIncome {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  source      String
  description String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("personal_income")
}

// ──────────────────────────────────────────────
// PERSONAL TRANSACTIONS — Unified budget tracker
// ──────────────────────────────────────────────

model PersonalTransaction {
  id          String              @id @default(cuid())
  date        DateTime
  amount      Decimal             @db.Decimal(12, 2)
  group       TransactionGroup
  category    TransactionCategory
  description String
  notes       String?
  recurring   Boolean             @default(false)
  /// Set when a human chose this classification — in the chat, in the form, or
  /// by splitting. The rule engine and the import must never overwrite it, so a
  /// correction made by hand survives every later re-import and rule change.
  manuallyClassified Boolean      @default(false)
  parentId    String?
  parent      PersonalTransaction?  @relation("TransactionSplits", fields: [parentId], references: [id])
  splits      PersonalTransaction[] @relation("TransactionSplits")
  createdAt   DateTime            @default(now())

  @@index([date])
  @@index([group])
  @@index([category])
  @@index([parentId])
  @@map("personal_transactions")
}

// ──────────────────────────────────────────────
// CLASSIFICATION RULES — Auto-categorize imports
// ──────────────────────────────────────────────

model ClassificationRule {
  id          String              @id @default(cuid())
  name        String
  priority    Int                 @default(0)
  matchField  String              @default("description")
  matchType   MatchType           @default(CONTAINS)
  matchValue  String
  group       TransactionGroup
  category    TransactionCategory
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())

  @@index([active])
  @@index([priority])
  @@map("classification_rules")
}

enum MatchType {
  CONTAINS
  STARTS_WITH
  ENDS_WITH
  EXACT
  REGEX
}

// ──────────────────────────────────────────────
// NET WORTH — Monthly snapshot tracking
// ──────────────────────────────────────────────

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  cash        Decimal  @db.Decimal(12, 2) @default(0)
  savings     Decimal  @db.Decimal(12, 2) @default(0)
  investments Decimal  @db.Decimal(12, 2) @default(0)
  property    Decimal  @db.Decimal(12, 2) @default(0)
  debt        Decimal  @db.Decimal(12, 2) @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([month, year])
  @@map("net_worth_snapshots")
}

// ──────────────────────────────────────────────
// BUDGETS — Monthly ceiling (expenses/debt) or target (savings) per category
// ──────────────────────────────────────────────

model Budget {
  id        String              @id @default(cuid())
  month     Int
  year      Int
  category  TransactionCategory
  amount    Decimal             @db.Decimal(12, 2)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([month, year, category])
  @@index([year, month])
  @@map("budgets")
}

enum TransactionGroup {
  INCOME
  FIXED_EXPENSE
  VARIABLE_EXPENSE
  SAVINGS
  DEBT
  UNEXPECTED
}

enum TransactionCategory {
  // Ingresos
  SALARY
  FREELANCE
  SALES
  BONUS
  AID
  OTHER_INCOME

  // Gastos fijos
  RENT
  UTILITIES
  INTERNET_PHONE
  TRANSPORT_FIXED
  SUBSCRIPTIONS
  INSURANCE
  CREDIT_PAYMENT
  EDUCATION_FIXED

  // Gastos variables
  GROCERIES
  RESTAURANTS
  TRANSPORT_VARIABLE
  CLOTHING
  PHARMACY
  PETS
  PERSONAL_CARE
  ENTERTAINMENT
  GIFTS
  REPAIRS

  // Ahorro
  GENERAL_SAVINGS
  EMERGENCY_FUND
  TRAVEL_FUND
  EDUCATION_FUND
  BIG_PURCHASE
  INVESTMENT

  // Deudas
  CREDIT_CARD
  PERSONAL_LOAN
  INSTALLMENT
  INTEREST
  PENDING_PAYMENT

  // Imprevistos
  EMERGENCY
  HEALTH
  UNEXPECTED_REPAIR
  FINE
  UNPLANNED
}

// ──────────────────────────────────────────────
// BUTTERFLY — Business lines, revenue, expenses
// ──────────────────────────────────────────────

model BusinessLine {
  id          String              @id @default(cuid())
  name        String              @unique
  color       String              @default("#6366f1")
  revenues    Revenue[]
  expenses    BusinessExpense[]
  pipeline    PipelineOpportunity[]
  events      Event[]
  timeEntries TimeEntry[]
  decisions   Decision[]

  @@map("business_lines")
}

model Revenue {
  id             String       @id @default(cuid())
  date           DateTime
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  client         String?
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([businessLineId])
  @@map("revenues")
}

model BusinessExpense {
  id             String       @id @default(cuid())
  date           DateTime
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  category       String?
  isOwnerDraw    Boolean      @default(false)
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([businessLineId])
  @@map("business_expenses")
}

model Event {
  id             String       @id @default(cuid())
  name           String
  date           DateTime
  revenue        Decimal      @db.Decimal(12, 2) @default(0)
  cost           Decimal      @db.Decimal(12, 2) @default(0)
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  status         EventStatus  @default(PLANNED)
  notes          String?
  timeEntries    TimeEntry[]
  decisions      Decision[]
  createdAt      DateTime     @default(now())

  @@map("events")
}

enum EventStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ──────────────────────────────────────────────
// PIPELINE — Forward-looking revenue
// ──────────────────────────────────────────────

model PipelineOpportunity {
  id             String         @id @default(cuid())
  account        String
  value          Decimal        @db.Decimal(12, 2)
  probability    Int
  closeDate      DateTime
  owner          String?
  businessLineId String
  businessLine   BusinessLine   @relation(fields: [businessLineId], references: [id])
  status         PipelineStatus @default(OPEN)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([closeDate])
  @@index([status])
  @@map("pipeline_opportunities")
}

enum PipelineStatus {
  OPEN
  WON
  LOST
}

// ──────────────────────────────────────────────
// WEALTH — Monthly balance sheet snapshot
// ──────────────────────────────────────────────

model WealthSnapshot {
  id             String   @id @default(cuid())
  month          Int
  year           Int
  cashPersonal   Decimal  @db.Decimal(12, 2) @default(0)
  cashBusiness   Decimal  @db.Decimal(12, 2) @default(0)
  emergencyFund  Decimal  @db.Decimal(12, 2) @default(0)
  investments    Decimal  @db.Decimal(12, 2) @default(0)
  debt           Decimal  @db.Decimal(12, 2) @default(0)
  butterflyValue Decimal  @db.Decimal(12, 2) @default(0)
  createdAt      DateTime @default(now())

  @@unique([month, year])
  @@map("wealth_snapshots")
}

// ──────────────────────────────────────────────
// TIME ENTRIES — Revenue per hour engine
// ──────────────────────────────────────────────

model TimeEntry {
  id             String       @id @default(cuid())
  date           DateTime
  hours          Decimal      @db.Decimal(6, 1)
  type           TimeEntryType
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  projectName    String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date])
  @@index([businessLineId])
  @@map("time_entries")
}

enum TimeEntryType {
  SALES
  DELIVERY
  CONTENT
  ADMIN
  EVENT_PREP
  NETWORKING
  STRATEGY
}

// ──────────────────────────────────────────────
// DECISIONS — Strategic decision log
// ──────────────────────────────────────────────

model Decision {
  id                String          @id @default(cuid())
  date              DateTime
  scope             DecisionScope
  title             String
  amount            Decimal?        @db.Decimal(12, 2)
  thresholdTriggered Boolean        @default(false)
  category          DecisionCategory
  businessLineId    String?
  businessLine      BusinessLine?   @relation(fields: [businessLineId], references: [id])
  eventId           String?
  event             Event?          @relation(fields: [eventId], references: [id])
  rationale         String?
  expectedROI       String?
  actualROI         String?
  status            DecisionStatus  @default(PLANNED)
  reviewDate        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([date])
  @@index([status])
  @@map("decisions")
}

enum DecisionScope {
  PERSONAL
  BUSINESS
}

enum DecisionCategory {
  HIRE
  EVENT
  TRAVEL
  TOOL
  PROJECT
  PARTNERSHIP
  INVESTMENT
}

enum DecisionStatus {
  PLANNED
  APPROVED
  DONE
  ABANDONED
}
