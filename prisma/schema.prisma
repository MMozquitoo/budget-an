generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// HOUSEHOLD — Simple burn rate tracker
// ──────────────────────────────────────────────

model HouseholdExpense {
  id          String            @id @default(cuid())
  date        DateTime
  amount      Decimal           @db.Decimal(12, 2)
  category    HouseholdCategory
  description String
  createdAt   DateTime          @default(now())

  @@index([date])
  @@map("household_expenses")
}

enum HouseholdCategory {
  FIXED
  VARIABLE
  FAMILY_TRAVEL
  NICOLAS
}

// ──────────────────────────────────────────────
// PERSONAL INCOME — Salary, unemployment, other
// ──────────────────────────────────────────────

model PersonalIncome {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  source      String
  description String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("personal_income")
}

// ──────────────────────────────────────────────
// BUTTERFLY — Business lines, revenue, expenses
// ──────────────────────────────────────────────

model BusinessLine {
  id          String              @id @default(cuid())
  name        String              @unique
  color       String              @default("#6366f1")
  revenues    Revenue[]
  expenses    BusinessExpense[]
  pipeline    PipelineOpportunity[]
  events      Event[]
  timeEntries TimeEntry[]
  decisions   Decision[]

  @@map("business_lines")
}

model Revenue {
  id             String       @id @default(cuid())
  date           DateTime
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  client         String?
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([businessLineId])
  @@map("revenues")
}

model BusinessExpense {
  id             String       @id @default(cuid())
  date           DateTime
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  category       String?
  isOwnerDraw    Boolean      @default(false)
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([businessLineId])
  @@map("business_expenses")
}

model Event {
  id             String       @id @default(cuid())
  name           String
  date           DateTime
  revenue        Decimal      @db.Decimal(12, 2) @default(0)
  cost           Decimal      @db.Decimal(12, 2) @default(0)
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  status         EventStatus  @default(PLANNED)
  notes          String?
  timeEntries    TimeEntry[]
  decisions      Decision[]
  createdAt      DateTime     @default(now())

  @@map("events")
}

enum EventStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ──────────────────────────────────────────────
// PIPELINE — Forward-looking revenue
// ──────────────────────────────────────────────

model PipelineOpportunity {
  id             String         @id @default(cuid())
  account        String
  value          Decimal        @db.Decimal(12, 2)
  probability    Int
  closeDate      DateTime
  owner          String?
  businessLineId String
  businessLine   BusinessLine   @relation(fields: [businessLineId], references: [id])
  status         PipelineStatus @default(OPEN)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([closeDate])
  @@index([status])
  @@map("pipeline_opportunities")
}

enum PipelineStatus {
  OPEN
  WON
  LOST
}

// ──────────────────────────────────────────────
// WEALTH — Monthly balance sheet snapshot
// ──────────────────────────────────────────────

model WealthSnapshot {
  id             String   @id @default(cuid())
  month          Int
  year           Int
  cashPersonal   Decimal  @db.Decimal(12, 2) @default(0)
  cashBusiness   Decimal  @db.Decimal(12, 2) @default(0)
  emergencyFund  Decimal  @db.Decimal(12, 2) @default(0)
  investments    Decimal  @db.Decimal(12, 2) @default(0)
  debt           Decimal  @db.Decimal(12, 2) @default(0)
  butterflyValue Decimal  @db.Decimal(12, 2) @default(0)
  createdAt      DateTime @default(now())

  @@unique([month, year])
  @@map("wealth_snapshots")
}

// ──────────────────────────────────────────────
// TIME ENTRIES — Revenue per hour engine
// ──────────────────────────────────────────────

model TimeEntry {
  id             String       @id @default(cuid())
  date           DateTime
  hours          Decimal      @db.Decimal(6, 1)
  type           TimeEntryType
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  projectName    String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date])
  @@index([businessLineId])
  @@map("time_entries")
}

enum TimeEntryType {
  SALES
  DELIVERY
  CONTENT
  ADMIN
  EVENT_PREP
  NETWORKING
  STRATEGY
}

// ──────────────────────────────────────────────
// DECISIONS — Strategic decision log
// ──────────────────────────────────────────────

model Decision {
  id                String          @id @default(cuid())
  date              DateTime
  scope             DecisionScope
  title             String
  amount            Decimal?        @db.Decimal(12, 2)
  thresholdTriggered Boolean        @default(false)
  category          DecisionCategory
  businessLineId    String?
  businessLine      BusinessLine?   @relation(fields: [businessLineId], references: [id])
  eventId           String?
  event             Event?          @relation(fields: [eventId], references: [id])
  rationale         String?
  expectedROI       String?
  actualROI         String?
  status            DecisionStatus  @default(PLANNED)
  reviewDate        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([date])
  @@index([status])
  @@map("decisions")
}

enum DecisionScope {
  PERSONAL
  BUSINESS
}

enum DecisionCategory {
  HIRE
  EVENT
  TRAVEL
  TOOL
  PROJECT
  PARTNERSHIP
  INVESTMENT
}

enum DecisionStatus {
  PLANNED
  APPROVED
  DONE
  ABANDONED
}
