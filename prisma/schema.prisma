generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// HOUSEHOLD — Simple burn rate tracker (legacy)
// ──────────────────────────────────────────────

model HouseholdExpense {
  id          String            @id @default(cuid())
  date        DateTime
  amount      Decimal           @db.Decimal(12, 2)
  category    HouseholdCategory
  description String
  createdAt   DateTime          @default(now())

  @@index([date])
  @@map("household_expenses")
}

enum HouseholdCategory {
  FIXED
  VARIABLE
  FAMILY_TRAVEL
  NICOLAS
}

// ──────────────────────────────────────────────
// PERSONAL INCOME — Salary, unemployment, other (legacy)
// ──────────────────────────────────────────────

model PersonalIncome {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  source      String
  description String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("personal_income")
}

// ──────────────────────────────────────────────
// PERSONAL TRANSACTIONS — Unified budget tracker
// ──────────────────────────────────────────────

model PersonalTransaction {
  id          String              @id @default(cuid())
  date        DateTime
  amount      Decimal             @db.Decimal(12, 2)
  /// References CategoryGroup.key / Category.key (enforced by a raw FK in
  /// the migration, not a Prisma relation — see lib/taxonomy.ts). Was a
  /// Postgres enum until the dynamic-taxonomy migration; kept as plain
  /// String so Adrien can create new groups/categories at runtime.
  group       String
  category    String
  description String
  notes       String?
  recurring   Boolean             @default(false)
  /// Set when a human chose this classification — in the chat, in the form, or
  /// by splitting. The rule engine and the import must never overwrite it, so a
  /// correction made by hand survives every later re-import and rule change.
  manuallyClassified Boolean      @default(false)
  parentId    String?
  parent      PersonalTransaction?  @relation("TransactionSplits", fields: [parentId], references: [id])
  splits      PersonalTransaction[] @relation("TransactionSplits")
  createdAt   DateTime            @default(now())

  @@index([date])
  @@index([group])
  @@index([category])
  @@index([parentId])
  @@map("personal_transactions")
}

// ──────────────────────────────────────────────
// CLASSIFICATION RULES — Auto-categorize imports
// ──────────────────────────────────────────────

model ClassificationRule {
  id          String              @id @default(cuid())
  name        String
  priority    Int                 @default(0)
  matchField  String              @default("description")
  matchType   MatchType           @default(CONTAINS)
  matchValue  String
  group       String
  category    String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())

  @@index([active])
  @@index([priority])
  @@map("classification_rules")
}

enum MatchType {
  CONTAINS
  STARTS_WITH
  ENDS_WITH
  EXACT
  REGEX
}

// ──────────────────────────────────────────────
// NET WORTH — Monthly snapshot tracking
// ──────────────────────────────────────────────

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  cash        Decimal  @db.Decimal(12, 2) @default(0)
  savings     Decimal  @db.Decimal(12, 2) @default(0)
  investments Decimal  @db.Decimal(12, 2) @default(0)
  property    Decimal  @db.Decimal(12, 2) @default(0)
  debt        Decimal  @db.Decimal(12, 2) @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([month, year])
  @@map("net_worth_snapshots")
}

// ──────────────────────────────────────────────
// BUDGETS — Monthly ceiling (expenses/debt) or target (savings) per category
// ──────────────────────────────────────────────

model Budget {
  id        String              @id @default(cuid())
  month     Int
  year      Int
  category  String
  amount    Decimal             @db.Decimal(12, 2)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([month, year, category])
  @@index([year, month])
  @@map("budgets")
}

// ──────────────────────────────────────────────
// SAVINGS GOALS — Cumulative target with a deadline (distinct from the
// monthly Budget above). Progress is never stored here — it's always derived
// from PersonalTransaction at read time, same philosophy as Budget.
// ──────────────────────────────────────────────

model SavingsGoal {
  id           String                @id @default(cuid())
  name         String
  targetAmount Decimal               @db.Decimal(12, 2)
  targetDate   DateTime
  /// Only transactions on/after this date count toward progress. Defaults to
  /// creation time; can be backdated if savings already started before the
  /// goal was entered.
  startDate    DateTime              @default(now())
  /// Null = counts the whole SAVINGS group. If set, must be a category
  /// belonging to the SAVINGS group (enforced in the API/agent layer).
  category     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([targetDate])
  @@index([category])
  @@map("savings_goals")
}

// ──────────────────────────────────────────────
// CHAT MEMORY — persisted assistant conversations
// ──────────────────────────────────────────────

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  /// Full UIMessage (id, role, parts) so a conversation reloads faithfully,
  /// including inline tool charts. `content` is the extracted text for titles.
  data           Json
  seq            Int
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

/// Facts the agent should know in every future conversation — the household's
/// holding structure, what a recurring counterparty actually is, a standing
/// target. Small and always loaded in full into the system prompt (see
/// lib/agent-memory.ts); no semantic search needed at this scale. Written
/// only via the rememberFact/forgetFact tools, and only when Adrien confirms
/// — same rule as every other agent write (see the SÉCURITÉ block in
/// budget-agent.ts's system prompt).
model AgentMemory {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_memory")
}

// ──────────────────────────────────────────────
// TAXONOMY — dynamic groups/categories (was a fixed Postgres enum; Adrien
// can now create new ones from the chat, see lib/taxonomy.ts). "behavior"
// generalizes what previously was ad-hoc `!== "TRANSFER" && !== "BUSINESS"`
// checks scattered across the pure-logic layer.
// ──────────────────────────────────────────────

model CategoryGroup {
  id         String     @id @default(cuid())
  key        String     @unique
  label      String
  /// Key into the fixed Tailwind palette in lib/utils.ts — Tailwind needs
  /// literal class names, so colors can't be built from arbitrary strings.
  colorTheme String
  order      Int
  /// "income" | "expense" | "savings" | "debt" | "excluded" — drives
  /// aggregate()'s totals. New custom groups may only be "expense" or
  /// "excluded"; the other three are reserved for the built-in groups.
  behavior   String     @default("expense")
  /// true for anything Adrien created via chat — protects the 8 built-ins.
  custom     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  categories Category[]

  @@map("category_groups")
}

model Category {
  id        String        @id @default(cuid())
  key       String        @unique
  label     String
  order     Int
  groupId   String
  group     CategoryGroup @relation(fields: [groupId], references: [id])
  custom    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([groupId])
  @@map("categories")
}

// ──────────────────────────────────────────────
// BUTTERFLY — Business lines, revenue, expenses
// ──────────────────────────────────────────────

model BusinessLine {
  id          String              @id @default(cuid())
  name        String              @unique
  color       String              @default("#6366f1")
  revenues    Revenue[]
  expenses    BusinessExpense[]
  pipeline    PipelineOpportunity[]
  events      Event[]
  timeEntries TimeEntry[]
  decisions   Decision[]

  @@map("business_lines")
}

model Revenue {
  id             String       @id @default(cuid())
  date           DateTime
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  client         String?
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([businessLineId])
  @@map("revenues")
}

model BusinessExpense {
  id             String       @id @default(cuid())
  date           DateTime
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  category       String?
  isOwnerDraw    Boolean      @default(false)
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([businessLineId])
  @@map("business_expenses")
}

model Event {
  id             String       @id @default(cuid())
  name           String
  date           DateTime
  revenue        Decimal      @db.Decimal(12, 2) @default(0)
  cost           Decimal      @db.Decimal(12, 2) @default(0)
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  status         EventStatus  @default(PLANNED)
  notes          String?
  timeEntries    TimeEntry[]
  decisions      Decision[]
  createdAt      DateTime     @default(now())

  @@map("events")
}

enum EventStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ──────────────────────────────────────────────
// PIPELINE — Forward-looking revenue
// ──────────────────────────────────────────────

model PipelineOpportunity {
  id             String         @id @default(cuid())
  account        String
  value          Decimal        @db.Decimal(12, 2)
  probability    Int
  closeDate      DateTime
  owner          String?
  businessLineId String
  businessLine   BusinessLine   @relation(fields: [businessLineId], references: [id])
  status         PipelineStatus @default(OPEN)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([closeDate])
  @@index([status])
  @@map("pipeline_opportunities")
}

enum PipelineStatus {
  OPEN
  WON
  LOST
}

// ──────────────────────────────────────────────
// WEALTH — Monthly balance sheet snapshot
// ──────────────────────────────────────────────

model WealthSnapshot {
  id             String   @id @default(cuid())
  month          Int
  year           Int
  cashPersonal   Decimal  @db.Decimal(12, 2) @default(0)
  cashBusiness   Decimal  @db.Decimal(12, 2) @default(0)
  emergencyFund  Decimal  @db.Decimal(12, 2) @default(0)
  investments    Decimal  @db.Decimal(12, 2) @default(0)
  debt           Decimal  @db.Decimal(12, 2) @default(0)
  butterflyValue Decimal  @db.Decimal(12, 2) @default(0)
  createdAt      DateTime @default(now())

  @@unique([month, year])
  @@map("wealth_snapshots")
}

// ──────────────────────────────────────────────
// TIME ENTRIES — Revenue per hour engine
// ──────────────────────────────────────────────

model TimeEntry {
  id             String       @id @default(cuid())
  date           DateTime
  hours          Decimal      @db.Decimal(6, 1)
  type           TimeEntryType
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  projectName    String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date])
  @@index([businessLineId])
  @@map("time_entries")
}

enum TimeEntryType {
  SALES
  DELIVERY
  CONTENT
  ADMIN
  EVENT_PREP
  NETWORKING
  STRATEGY
}

// ──────────────────────────────────────────────
// DECISIONS — Strategic decision log
// ──────────────────────────────────────────────

model Decision {
  id                String          @id @default(cuid())
  date              DateTime
  scope             DecisionScope
  title             String
  amount            Decimal?        @db.Decimal(12, 2)
  thresholdTriggered Boolean        @default(false)
  category          DecisionCategory
  businessLineId    String?
  businessLine      BusinessLine?   @relation(fields: [businessLineId], references: [id])
  eventId           String?
  event             Event?          @relation(fields: [eventId], references: [id])
  rationale         String?
  expectedROI       String?
  actualROI         String?
  status            DecisionStatus  @default(PLANNED)
  reviewDate        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([date])
  @@index([status])
  @@map("decisions")
}

enum DecisionScope {
  PERSONAL
  BUSINESS
}

enum DecisionCategory {
  HIRE
  EVENT
  TRAVEL
  TOOL
  PROJECT
  PARTNERSHIP
  INVESTMENT
}

enum DecisionStatus {
  PLANNED
  APPROVED
  DONE
  ABANDONED
}
